COMPOSE_PROJECT_NAME=time-agent
TIME_AGENT_HTTP_PORT=8080

DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,django,nginx
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,https://localhost
# Browser account registration. Turn this off after creating invited accounts if
# the deployment should not accept public sign-ups.
AUTH_REGISTRATION_ENABLED=true
# Isolated temporary guest workspaces. Keep disabled unless the deployment is
# intended to expose a public product demo.
GUEST_ACCESS_ENABLED=false
GUEST_ACCOUNT_TTL_HOURS=24
GUEST_ACCOUNT_CREATION_RATE=3/hour
GUEST_AGENT_RUN_LIMIT=10
GUEST_MAX_CONVERSATIONS=20
GUEST_MAX_EVENTS=50
GUEST_MAX_TASKS=50
GUEST_MAX_REMINDERS=80
GUEST_MAX_BRIEFING_DEFINITIONS=10
GUEST_CLEANUP_BATCH_SIZE=100
# Production transport security. Enable HSTS only after HTTPS is fully verified.
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
POSTGRES_DB=time_agent
POSTGRES_USER=time_agent
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Optional: use a separate PostgreSQL database for LangGraph persistence.
# When empty, the Django default PostgreSQL connection settings are reused.
LANGGRAPH_DATABASE_URL=
LANGGRAPH_POSTGRES_CONNECT_TIMEOUT=10
LANGGRAPH_STORE_POOL_MIN_SIZE=1
LANGGRAPH_STORE_POOL_MAX_SIZE=10
# Backend build base images. Keep official images by default. If GHCR or
# Docker Hub is unreachable, override these with trusted registry mirrors.
# UV_IMAGE=docker.1ms.run/ghcr.io/astral-sh/uv:0.11.29
# PYTHON_IMAGE=docker.1ms.run/library/python:3.12-slim
# NODE_IMAGE=docker.1ms.run/library/node:24-alpine
# FRONTEND_NGINX_IMAGE=docker.1ms.run/library/nginx:1.28-alpine
# NGINX_IMAGE=docker.1ms.run/library/nginx:1.28-alpine
UV_IMAGE=ghcr.io/astral-sh/uv:0.11.29
PYTHON_IMAGE=python:3.12-slim
NODE_IMAGE=node:24-alpine
FRONTEND_NGINX_IMAGE=nginx:1.28-alpine
NGINX_IMAGE=nginx:1.28-alpine
# Keep the official image name by default. If Docker Hub is unreachable,
# override with a trusted registry mirror, for example:
# POSTGRES_IMAGE=docker.1ms.run/library/postgres:17-alpine
POSTGRES_IMAGE=postgres:17-alpine

REDIS_URL=redis://redis:6379/0
AGENT_API_KEY=
AGENT_BASE_URL=
AGENT_DEEPSEEK_API_KEY=
# Example: https://api.deepseek.com or an OpenAI-compatible endpoint ending in /v1
AGENT_DEEPSEEK_BASE_URL=
AGENT_CLAUDE_API_KEY=
AGENT_CLAUDE_BASE_URL=
# Optional path relative to backend/ locally and /app in the backend containers.
# The committed validated default is config/agent.example.yaml.
TIME_AGENT_CONFIG_PATH=config/agent.example.yaml
ACTION_PROPOSAL_TTL_SECONDS=86400
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
TIME_MEMORY_PROMPT_TOKEN_BUDGET=800
TIME_MEMORY_REFRESH_DELAY_SECONDS=5
TIME_MEMORY_AUTO_REFRESH_ENABLED=true

DEFAULT_TIMEZONE=Asia/Shanghai
DEFAULT_LOCALE=zh-CN
LOG_LEVEL=INFO
# Prometheus is enabled only with docker-compose.observability.yml and remains
# loopback-only on port 9090. Do not expose it through Cloudflare Tunnel.
# PROMETHEUS_IMAGE=prom/prometheus:v3.5.0

# Notification defaults
NOTIFICATION_DEFAULT_CHANNEL=console
NOTIFICATION_MAX_RETRIES=4
NOTIFICATION_SENDING_STALE_SECONDS=300

# Email. Leave credentials empty in source control.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_FROM_ADDRESS=Time Agent <noreply@localhost>
EMAIL_TIMEOUT_SECONDS=10
ALERTMANAGER_EMAIL_TO=

# Web Push. The private key is backend-only; the public key is served by API.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=
WEB_PUSH_TIMEOUT_SECONDS=10
# Optional HTTP(S) forward proxy for push providers such as FCM. Keep proxy
# credentials server-side; never expose this value through VITE_* variables.
WEB_PUSH_HTTPS_PROXY=

# Live external delivery checks are opt-in.
RUN_LIVE_NOTIFICATION_TESTS=0
# LIVE_NOTIFICATION_EMAIL=
# LIVE_WEB_PUSH_ENDPOINT=
# LIVE_WEB_PUSH_P256DH=
# LIVE_WEB_PUSH_AUTH=

# Server-only reverse geocoding. The AMap Web Service key must never use VITE_*.
AMAP_WEB_SERVICE_KEY=
AMAP_REVERSE_GEOCODING_TIMEOUT_SECONDS=5
AMAP_WEATHER_ENABLED=false
AMAP_WEATHER_TIMEOUT_SECONDS=8
NOMINATIM_REVERSE_GEOCODING_TIMEOUT_SECONDS=5

VITE_APP_NAME=Time Agent
VITE_API_BASE_URL=

# Android self-hosted update manifest. The APK must use the same application ID
# and signing certificate as the installed release; Android still asks the user
# to confirm installation.
ANDROID_UPDATE_ENABLED=false
ANDROID_UPDATE_VERSION_CODE=6
ANDROID_UPDATE_VERSION_NAME=1.1.2
ANDROID_UPDATE_DOWNLOAD_URL=https://steward.example.com/releases/timeagent-1.1.2.apk
ANDROID_UPDATE_SHA256=
ANDROID_UPDATE_SIZE_BYTES=1
ANDROID_UPDATE_RELEASE_NOTES=
ANDROID_UPDATE_PUBLISHED_AT=2026-08-07T00:00:00Z
ANDROID_UPDATE_MINIMUM_SUPPORTED_VERSION_CODE=5
VITE_REQUEST_TIMEOUT_MS=5000
VITE_DEFAULT_TIMEZONE=Asia/Shanghai
