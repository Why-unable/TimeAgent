discovery.docker "timeagent" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "timeagent_logs" {
  targets = discovery.docker.timeagent.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = "time-agent"
    action        = "keep"
  }
}

loki.source.docker "timeagent" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.relabel.timeagent_logs.output
  forward_to    = [loki.write.local.receiver]
  refresh_interval = "5s"
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
