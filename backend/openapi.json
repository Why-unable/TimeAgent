components:
  schemas:
    ActionProposal:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        conversation_id:
          type: string
          format: uuid
          readOnly: true
        agent_run_id:
          type: string
          format: uuid
          readOnly: true
        original_request:
          type: string
          readOnly: true
        explanation:
          type: string
          readOnly: true
        action_type:
          type: string
          readOnly: true
        action_payload:
          readOnly: true
        original_payload:
          readOnly: true
        display_context:
          readOnly: true
        risk_level:
          allOf:
          - $ref: '#/components/schemas/RiskLevelEnum'
          readOnly: true
        status:
          allOf:
          - $ref: '#/components/schemas/ActionProposalStatusEnum'
          readOnly: true
        requires_approval:
          type: boolean
          readOnly: true
        version:
          type: integer
          readOnly: true
        expires_at:
          type: string
          format: date-time
          readOnly: true
        decided_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
        approved_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
        resumed_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
        executed_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
        decision_reason:
          type: string
          readOnly: true
        execution_result:
          readOnly: true
          nullable: true
        error:
          type: string
          readOnly: true
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - action_payload
      - action_type
      - agent_run_id
      - approved_at
      - conversation_id
      - created_at
      - decided_at
      - decision_reason
      - display_context
      - error
      - executed_at
      - execution_result
      - expires_at
      - explanation
      - id
      - original_payload
      - original_request
      - requires_approval
      - resumed_at
      - risk_level
      - status
      - updated_at
      - version
    ActionProposalStatusEnum:
      enum:
      - awaiting_approval
      - approved
      - rejected
      - executing
      - executed
      - failed
      - expired
      type: string
      description: |-
        * `awaiting_approval` - Awaiting approval
        * `approved` - Approved
        * `rejected` - Rejected
        * `executing` - Executing
        * `executed` - Executed
        * `failed` - Failed
        * `expired` - Expired
    AdministrativeAreaOption:
      type: object
      properties:
        code:
          type: string
        name:
          type: string
      required:
      - code
      - name
    AgentRun:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        conversation_id:
          type: string
          format: uuid
          readOnly: true
        operation_id:
          type: string
          format: uuid
          readOnly: true
        request_id:
          type: string
          readOnly: true
        trigger_type:
          type: string
          readOnly: true
        trigger_payload:
          readOnly: true
        synthetic_input:
          type: boolean
          readOnly: true
        status:
          allOf:
          - $ref: '#/components/schemas/AgentRunStatusEnum'
          readOnly: true
        input_message:
          type: string
          readOnly: true
        anchor_at:
          type: string
          format: date-time
          readOnly: true
        anchor_timezone:
          type: string
          readOnly: true
        final_response:
          type: string
          readOnly: true
        error:
          type: string
          readOnly: true
        started_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
        completed_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
        created_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - anchor_at
      - anchor_timezone
      - completed_at
      - conversation_id
      - created_at
      - error
      - final_response
      - id
      - input_message
      - operation_id
      - request_id
      - started_at
      - status
      - synthetic_input
      - trigger_payload
      - trigger_type
    AgentRunStatusEnum:
      enum:
      - pending
      - running
      - waiting_approval
      - completed
      - failed
      - cancelled
      type: string
      description: |-
        * `pending` - Pending
        * `running` - Running
        * `waiting_approval` - Waiting for approval
        * `completed` - Completed
        * `failed` - Failed
        * `cancelled` - Cancelled
    AndroidRelease:
      type: object
      properties:
        version_code:
          type: integer
          minimum: 1
        version_name:
          type: string
        download_url:
          type: string
          format: uri
        sha256:
          type: string
          pattern: ^[0-9a-f]{64}$
        size_bytes:
          type: integer
          minimum: 1
        release_notes:
          type: string
        published_at:
          type: string
          format: date-time
        minimum_supported_version_code:
          type: integer
          minimum: 1
      required:
      - download_url
      - minimum_supported_version_code
      - published_at
      - release_notes
      - sha256
      - size_bytes
      - version_code
      - version_name
    AndroidUpdateResponse:
      type: object
      properties:
        enabled:
          type: boolean
        release:
          allOf:
          - $ref: '#/components/schemas/AndroidRelease'
          nullable: true
      required:
      - enabled
      - release
    AuthToken:
      type: object
      properties:
        token:
          type: string
          readOnly: true
        user:
          allOf:
          - $ref: '#/components/schemas/CurrentUser'
          readOnly: true
      required:
      - token
      - user
    BlankEnum:
      enum:
      - ''
    BriefingDefinition:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        name:
          type: string
          maxLength: 120
        enabled_sections: {}
        locale:
          type: string
          maxLength: 32
        timezone:
          type: string
          maxLength: 64
        style:
          $ref: '#/components/schemas/StyleEnum'
        include_empty_sections:
          type: boolean
        is_active:
          type: boolean
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - created_at
      - id
      - name
      - updated_at
    BriefingRun:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        definition_id:
          type: string
          format: uuid
          readOnly: true
        conversation_id:
          type: string
          format: uuid
          readOnly: true
          nullable: true
        agent_run_id:
          type: string
          format: uuid
          readOnly: true
          nullable: true
        operation_id:
          type: string
          format: uuid
          readOnly: true
        trigger_type:
          type: string
          readOnly: true
        target_date:
          type: string
          format: date
          readOnly: true
        timezone:
          type: string
          readOnly: true
        status:
          allOf:
          - $ref: '#/components/schemas/BriefingRunStatusEnum'
          readOnly: true
        definition_snapshot:
          readOnly: true
        structured_result:
          readOnly: true
        research_report:
          readOnly: true
        rendered_markdown:
          type: string
          readOnly: true
        warnings:
          readOnly: true
        model_config_snapshot:
          readOnly: true
        prompt_version:
          type: string
          readOnly: true
        failure_code:
          type: string
          readOnly: true
        failure_message:
          type: string
          readOnly: true
        started_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
        completed_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
        created_at:
          type: string
          format: date-time
          readOnly: true
        section_runs:
          type: array
          items:
            $ref: '#/components/schemas/BriefingSectionRun'
          readOnly: true
      required:
      - agent_run_id
      - completed_at
      - conversation_id
      - created_at
      - definition_id
      - definition_snapshot
      - failure_code
      - failure_message
      - id
      - model_config_snapshot
      - operation_id
      - prompt_version
      - rendered_markdown
      - research_report
      - section_runs
      - started_at
      - status
      - structured_result
      - target_date
      - timezone
      - trigger_type
      - warnings
    BriefingRunStatusEnum:
      enum:
      - pending
      - running
      - completed
      - partial
      - failed
      type: string
      description: |-
        * `pending` - Pending
        * `running` - Running
        * `completed` - Completed
        * `partial` - Partial
        * `failed` - Failed
    BriefingSectionRun:
      type: object
      properties:
        id:
