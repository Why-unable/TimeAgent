  /api/v1/auth/token/:
    post:
      operationId: api_v1_auth_token_create
      description: |-
        Exchange credentials for a DRF auth token (native app channel).

        Explicitly clears authentication_classes so SessionAuthentication's CSRF
        enforcement does not apply — native clients have no CSRF cookie. Credentials
        are validated exactly as the session LoginView, reusing AccountService.
      tags:
      - api
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/Login'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/Login'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/Login'
        required: true
      security:
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AuthToken'
          description: ''
  /api/v1/auth/token/revoke/:
    post:
      operationId: api_v1_auth_token_revoke_create
      description: Delete the caller's auth token (native app logout).
      tags:
      - api
      security:
      - tokenAuth: []
      - cookieAuth: []
