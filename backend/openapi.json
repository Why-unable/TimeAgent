  /api/v1/events/:
    get:
      operationId: api_v1_events_list
      parameters:
      - in: query
        name: ends_after
        schema:
          type: string
          format: date-time
      - in: query
        name: starts_before
        schema:
          type: string
          format: date-time
      - in: query
        name: status
        schema:
          type: array
          items:
            enum:
            - tentative
            - confirmed
            - cancelled
            type: string
            description: |-
              * `tentative` - Tentative
              * `confirmed` - Confirmed
              * `cancelled` - Cancelled
      tags:
      - api
      security:
