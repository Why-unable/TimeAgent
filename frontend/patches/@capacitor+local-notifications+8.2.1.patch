+package com.capacitorjs.plugins.localnotifications;
+
+import android.content.Context;
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+public final class NotificationDiagnosticsStore {
+    private static final String PREFERENCES = "time_agent_notification_diagnostics";
+    private static final String ENTRIES = "entries";
+    private static final int MAX_ENTRIES = 200;
+
+    private NotificationDiagnosticsStore() {}
+
+    public static synchronized void append(
+        Context context,
+        String kind,
+        int notificationId,
+        Long scheduledAt,
+        String title
+    ) {
+        JSONArray existing = readArray(context);
+        JSONArray updated = new JSONArray();
+        JSONObject entry = new JSONObject();
+        try {
+            entry.put("kind", kind);
+            entry.put("notificationId", notificationId);
+            entry.put("recordedAt", System.currentTimeMillis());
+            if (scheduledAt != null) entry.put("scheduledAt", scheduledAt);
+            if (title != null) entry.put("title", title);
+            updated.put(entry);
+            for (int index = 0; index < existing.length() && index < MAX_ENTRIES - 1; index += 1) {
+                updated.put(existing.get(index));
+            }
+            context.getSharedPreferences(PREFERENCES, Context.MODE_PRIVATE)
+                .edit().putString(ENTRIES, updated.toString()).apply();
+        } catch (JSONException ignored) {}
+    }
+
+    public static synchronized JSONArray read(Context context) {
+        return readArray(context);
+    }
+
+    public static synchronized void clear(Context context) {
+        context.getSharedPreferences(PREFERENCES, Context.MODE_PRIVATE)
+            .edit().remove(ENTRIES).apply();
+    }
+
+    private static JSONArray readArray(Context context) {
+        String value = context.getSharedPreferences(PREFERENCES, Context.MODE_PRIVATE)
+            .getString(ENTRIES, "[]");
+        try {
+            return new JSONArray(value);
+        } catch (JSONException ignored) {
+            return new JSONArray();
+        }
+    }
+}
